# Tất cả trỏ về tương đối để trình duyệt tự lấy domain blog.example.com
VITE_API_USER_SERVICE=/api/auth
VITE_API_BLOG_SERVICE=/api/blog
VITE_API_FILE_SERVICE=/api/file
VITE_API_INTERACTION_SERVICE=/api/interaction
VITE_API_CUSTOMER_SERVICE=/api/customer

# Khi dùng Ingress, các biến Host/Port dưới đây thường không còn quan trọng 
# vì code sẽ call trực tiếp vào domain đang chạy web
VITE_BACKEND_HOST=blog.example.com
VITE_ENV=production
